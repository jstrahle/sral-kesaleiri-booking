{
	email {$ACME_EMAIL}
}

(turva) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Hallintapuoli - oma verkkotunnus
{$ADMIN_DOMAIN} {
	import turva
	encode zstd gzip
	reverse_proxy admin:3000
	log {
		output stdout
		format console
	}
}

# Julkinen verkkopalvelu
{$PUBLIC_DOMAIN} {
	import turva
	encode zstd gzip

	# SSE-kanava: ei puskurointia
	@sse path /events
	handle @sse {
		reverse_proxy public:3000 {
			flush_interval -1
		}
	}

	# Sisainen synkronointipaate ei saa nakya internetiin
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	handle {
		reverse_proxy public:3000
	}

	log {
		output stdout
		format console
	}
}
