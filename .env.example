# --- Verkkotunnukset ---------------------------------------------------------
ADMIN_DOMAIN=hallinta.esimerkki.fi
PUBLIC_DOMAIN=leiri.esimerkki.fi
ACME_EMAIL=yllapito@esimerkki.fi

# --- Hallintapuolen tietokanta ----------------------------------------------
ADMIN_DB_NAME=kesaleiri_admin
ADMIN_DB_USER=kesaleiri_admin
ADMIN_DB_PASSWORD=vaihda-tama-pitkaan-satunnaiseen-arvoon

# --- Julkisen palvelun tietokanta (erillinen, ei paasya hallintadataan) ------
PUBLIC_DB_NAME=kesaleiri_public
PUBLIC_DB_USER=kesaleiri_public
PUBLIC_DB_PASSWORD=vaihda-tama-pitkaan-satunnaiseen-arvoon

# --- Synkronoinnin jaettu salaisuus (HMAC-SHA256) ---------------------------
# Luo esim.: openssl rand -hex 32
SYNC_SHARED_SECRET=vaihda-tama-32-tavun-satunnaiseen-arvoon

# --- Istunnot ---------------------------------------------------------------
# Luo esim.: openssl rand -hex 32
SESSION_SECRET=vaihda-tama-32-tavun-satunnaiseen-arvoon

# --- Ensimmaisen adminin luonti (vain ensimmaisella kaynnistyksella) --------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=vaihda-tama-heti-ensimmaisen-kirjautumisen-jalkeen

# --- Varmistukset -----------------------------------------------------------
BACKUP_CRON=0 * * * *
BACKUP_RETENTION_DAYS=14

# --- Muuta ------------------------------------------------------------------
TZ=Europe/Helsinki
LOG_LEVEL=info
